# Copy to .env and update as appropriate

# ssh host or alias
HOST=your-server

# Directory the stack lives in on the host (Docker), or the htdocs the static
# files are served from (plain host)
DIR=/opt/emf-schedule

# 1 = plain host that serves the static files and manages nginx itself;
#     `make deploy` rsyncs only index.html/styles.css/app.js.
# 0 = target runs the site as a Docker stack, so `make deploy` also rsyncs
#     nginx.conf/compose.yaml and runs `docker compose up`.
HOST_IS_BAREMETAL=0
